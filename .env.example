# Copy to `.env` and fill in. NEVER commit real values — `.env` is gitignored.

# ---- Telegram application credentials (https://my.telegram.org → API development tools) ----
# One pair for the whole server; every person logs in through it with their own phone.
TG_API_ID=0000000
TG_API_HASH=your_api_hash_here

# ---- Public URL + master secret (required) ----
# HTTPS origin where this server is reachable (no trailing slash). OAuth issuer + links.
PUBLIC_BASE_URL=https://tg-mcp.example.com
# Encrypts stored Telegram sessions and signs cookies. >= 32 random chars:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every stored session (everyone must reconnect).
APP_SECRET_KEY=

# ---- Brain / AI providers (notebook_* tools) ----
# provider: gemini | openai | ollama (local, default in the code)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
# transcription of voice/video: gemini | openai | local (faster-whisper, pip extra)
TRANSCRIPTION_PROVIDER=gemini
TRANSCRIPTION_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
OPENAI_API_KEY=
# Only for the ollama provider:
OLLAMA_BASE_URL=http://localhost:11434

# ---- Optional ----
# Restrict who may connect (comma-separated phones with country code). Empty = anyone.
ALLOWED_PHONES=
# Let users type their own api_id/api_hash on the login page (advanced section).
ALLOW_USER_API_CREDENTIALS=1
APP_NAME=Telegram MCP
# Telegram bot front-end for the same archive (docker compose --profile bot):
TELEGRAM_BOT_TOKEN=

# ---- Server / storage ----
DATA_DIR=/data
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Access token lifetime (s); clients refresh automatically.
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=7776000
# Disconnect an idle Telegram client after this many seconds.
TG_CLIENT_IDLE_SECONDS=900
# Auto-sleep through FloodWaits up to this many seconds.
TG_FLOODWAIT_CAP=45
# Upload cap for file_url / file_base64 (MB) and timeout (s).
TG_MAX_UPLOAD_MB=32
TG_IMAGE_TIMEOUT=30
# file_url may only point at public addresses (SSRF guard). 1 = allow private hosts.
TG_ALLOW_PRIVATE_IMAGE_HOSTS=0
# Login-code requests allowed per IP per hour.
LOGIN_CODES_PER_HOUR=10
